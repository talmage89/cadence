# Directory of agent specs: one Markdown file per agent, frontmatter on top.
CADENCE_AGENTS_DIRECTORY=~/agents

# Where cadence keeps dispatch state and live session records.
CADENCE_STATE_DIRECTORY=~/.local/state/cadence

# Optional. Dispatch and per-agent logs. Defaults to <state directory>/logs.
# CADENCE_LOG_DIRECTORY=/tmp/cadence

# Optional. Working directory for agents whose spec sets no cwd. Defaults to your home directory.
# CADENCE_DEFAULT_CWD=~
